{
  "rules": {
    ".read": false,
    ".write": false,

    "sessions": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'easythaiwithnita@gmail.com'"
    },

    "entries": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'easythaiwithnita@gmail.com'",
      "$entryId": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || auth.token.email === 'easythaiwithnita@gmail.com')"
      }
    },

    "assignments": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'easythaiwithnita@gmail.com'",
      "$assignmentId": {
        "submissions": {
          "$uid": {
            ".write": "auth != null && ($uid === auth.uid || auth.token.email === 'easythaiwithnita@gmail.com')"
          }
        }
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
